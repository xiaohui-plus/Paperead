{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Paperead",
  "version": "0.2.2",
  "identifier": "com.paperead.desktop",
  "build": {
    "frontendDist": "../web/dist",
    "beforeBuildCommand": "npm --prefix web run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/paperead-server",
      "resources/agent"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://gitee.com/deng_xiaohui/paperead/releases/download/latest/latest.json",
        "https://github.com/xiaohui-plus/Paperead/releases/latest/download/latest.json",
        "https://ghproxy.net/https://github.com/xiaohui-plus/Paperead/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEwNUM5N0ZEMjI0QjZERkEKUldUNmJVc2kvWmRjb09OUU5qRCtBWGpGK0tqQWxXMktWUnFEd2Z3eG5BZ3NlcDJEWlJNZDNHQzAK"
    }
  }
}