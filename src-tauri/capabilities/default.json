{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Paperead desktop capability",
  "windows": ["main"],
  "platforms": ["windows", "macOS", "linux"],
  "remote": {
    "urls": ["http://127.0.0.1:*", "http://localhost:*"]
  },
  "permissions": [
    "core:default",
    "dialog:default",
    "opener:default",
    "allow-check-desktop-update",
    "allow-install-update",
    "allow-restart-app"
  ]
}