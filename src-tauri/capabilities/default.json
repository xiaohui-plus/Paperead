{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Paperead desktop capability",
  "windows": ["main"],
  "platforms": ["windows", "macOS", "linux"],
  "remote": {
    "urls": ["http://127.0.0.1:*", "http://localhost:*"]
  },
  "permissions": [
    "core:default",
    "dialog:default",
    "opener:default",
    "allow-check-desktop-update",
    "allow-install-update",
    "allow-install-prepared-update",
    "allow-get-update-status",
    "allow-restart-app",
    "allow-save-pdf-file",
    "allow-save-translated-pdf",
    "allow-browser-extension-setup",
    "allow-open-browser-extensions",
    "allow-open-extension-folder"
  ]
}