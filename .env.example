# LLM 配置（三种变量名按优先级：PAPEREAD_* > OPENAI_*）
# 旧版前缀 PAPER_REFLOW_* 仍然可用，会和 PAPEREAD_* 一起读取。
# DeepSeek
PAPEREAD_API_KEY=sk-xxxxxxxx
PAPEREAD_BASE_URL=https://api.deepseek.com/v1
PAPEREAD_MODEL=deepseek-chat

# 也可以接任意 OpenAI 兼容服务（SiliconFlow / vLLM / Ollama / OneAPI）
# PAPEREAD_BASE_URL=https://api.siliconflow.cn/v1
# PAPEREAD_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
# PAPEREAD_BASE_URL=http://localhost:11434/v1
# PAPEREAD_MODEL=qwen2.5:32b

# 单次请求超时（秒）
PAPEREAD_TIMEOUT=300

# 学术检索可选凭据（都免费申请）
# Semantic Scholar：不填也能检索，但共享池容易 429 限流
PAPEREAD_S2_API_KEY=
# CORE：不填时该数据源会在检索页置灰
PAPEREAD_CORE_API_KEY=
# 开放获取查询的礼貌池邮箱（Unpaywall / OpenAlex）
PAPEREAD_MAILTO=
