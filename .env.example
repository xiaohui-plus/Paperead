# LLM 配置（三种变量名按优先级：PAPER_REFLOW_* > OPENAI_*）
# DeepSeek
PAPER_REFLOW_API_KEY=sk-xxxxxxxx
PAPER_REFLOW_BASE_URL=https://api.deepseek.com/v1
PAPER_REFLOW_MODEL=deepseek-chat

# 也可以接任意 OpenAI 兼容服务（SiliconFlow / vLLM / Ollama / OneAPI）
# PAPER_REFLOW_BASE_URL=https://api.siliconflow.cn/v1
# PAPER_REFLOW_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
# PAPER_REFLOW_BASE_URL=http://localhost:11434/v1
# PAPER_REFLOW_MODEL=qwen2.5:32b

# 单次请求超时（秒）
PAPER_REFLOW_TIMEOUT=300
